VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional public contact mailbox. Leave blank until the address is ready.
# Setting it enables "Open email draft"; it does not send email from the website.
VITE_CONTACT_EMAIL=
# Public project URL and anon/publishable key only. Never put a service-role key in VITE_ variables.
# The delete-account Edge Function uses Supabase-managed SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Set ALLOWED_ORIGIN as an Edge Function secret, e.g. https://your-app.vercel.app (no trailing slash).
